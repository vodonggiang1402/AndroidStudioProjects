<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CALL_PHONE"
        tools:ignore="PermissionImpliesUnsupportedChromeOsHardware" />
    <application
        android:name="Base.TMadeApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.TMade"
        tools:targetApi="31">
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="ca-app-pub-9183925814024348~3404910077"/>
        <activity
            android:name="Modules.TutorialScreen.TutorialDetail.TutorialDetailScreen"
            android:exported="false" />
        <activity
            android:name="Modules.SettingScreen.Contact.ContactScreen"
            android:exported="false" />
        <activity
            android:name="Modules.SettingScreen.Language.LanguageScreen"
            android:exported="false" />
        <activity
            android:name="Modules.SymbolScreen.SymbolDetail.SymbolDetail"
            android:exported="false" />
        <activity
            android:name="Plash.SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.TMade">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name="Main.MainActivity"
            android:exported="false" />
    </application>
</manifest>