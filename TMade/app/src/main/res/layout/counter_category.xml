<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/background_color"
    android:orientation="vertical">
    <LinearLayout
        android:id="@+id/layout_edit"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="0dp">
        <TextView
            android:id="@+id/counter_category_title"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="0dp"
            android:textSize="16sp"
            android:paddingStart="12dp"
            android:paddingEnd="0dp"
            android:gravity="center_vertical"
            android:textColor="@android:color/black"
            android:text="@string/main_counter_text"
            android:drawablePadding="20dp"
            android:background="@color/background_color"
            app:drawableLeftCompat="@drawable/ico_refresh" />
        <Button
            android:id="@+id/counter_refresh_button"
            style="?android:attr/buttonBarButtonStyle"
            android:layout_marginEnd="12dp"
            android:gravity="end"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:drawableRightCompat="@drawable/ico_refresh"
            tools:ignore="SpeakableTextPresentCheck" />
    </LinearLayout>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rcv_counter_category"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="20dp"
        android:paddingBottom="30dp"
        android:background="@color/background_color"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp" />
</LinearLayout>